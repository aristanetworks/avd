{# eos - ip large community lists #}
{% for ip_large_community_list in ip_large_community_lists | arista.avd.natural_sort(sort_key='name', ignore_case=false) %}
!
{%     for entry in ip_large_community_list.entries %}
ip large-community-list {{ ip_large_community_list.name }} {{ entry.action }} {{ entry.large_communities }}
{%     endfor %}
{%     for entry in ip_large_community_list.entries %}
ip large-community-list regexp {{ ip_large_community_list.name }} {{ entry.action }} {{ entry.regexp }}
{%     endfor %}
{% endfor %}
