{# eos - ipv6 unicast routing vrfs #}
{% set v6_vrf = namespace(tracker_exclamation=false) %}
{% for vrf in vrfs | arista.avd.natural_sort('name', ignore_case=false) %}
{%     if vrf.ipv6_routing is arista.avd.defined(true) and vrf.name != 'default' %}
{%         if not v6_vrf.tracker_exclamation %}
!
{%             set v6_vrf.tracker_exclamation = true %}
{%         endif %}
ipv6 unicast-routing vrf {{ vrf.name }}
{%     endif %}
{% endfor %}
