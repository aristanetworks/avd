{# eos - ip tacacs source interfaces #}
{% if ip_tacacs is arista.avd.defined %}
!
{%     if ip_tacacs.source_interface is arista.avd.defined %}
ip tacacs source-interface {{ ip_tacacs.source_interface }}
{%     endif %}
{%     for vrf in ip_tacacs.vrfs | arista.avd.natural_sort('name', ignore_case=false) %}
ip tacacs vrf {{ vrf.name }} source-interface {{ vrf.source_interface }}
{%     endfor %}
{% elif ip_tacacs_source_interfaces is arista.avd.defined %}
!
{%     for ip_tacacs in ip_tacacs_source_interfaces | arista.avd.natural_sort(sort_key='name') %}
{%         set ip_tacacs_cli = "ip tacacs" %}
{%         if ip_tacacs.vrf is arista.avd.defined %}
{%             set ip_tacacs_cli = ip_tacacs_cli ~ " vrf " ~ ip_tacacs.vrf %}
{%         endif %}
{%         set ip_tacacs_cli = ip_tacacs_cli ~ " source-interface " ~ ip_tacacs.name %}
{{ ip_tacacs_cli }}
{%     endfor %}
{% endif %}
