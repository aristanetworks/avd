{# eos - management security #}
{% if management_security is arista.avd.defined %}
!
management security
{%     for auto_certificate_profile in management_security.auto_certificate.profiles | arista.avd.natural_sort(sort_key="name", ignore_case=false) %}
   auto-certificate profile {{ auto_certificate_profile.name }}
{%         if auto_certificate_profile.key is arista.avd.defined %}
      key {{ auto_certificate_profile.key }}
{%         endif %}
{%         if auto_certificate_profile.parameters.distinguished_name.common_name is arista.avd.defined %}
      parameters distinguished-name common-name "{{ auto_certificate_profile.parameters.distinguished_name.common_name }}"
{%         endif %}
{%         if auto_certificate_profile.parameters.distinguished_name.country is arista.avd.defined %}
      parameters distinguished-name country {{ auto_certificate_profile.parameters.distinguished_name.country }}
{%         endif %}
{%         if auto_certificate_profile.parameters.distinguished_name.state is arista.avd.defined %}
      parameters distinguished-name state "{{ auto_certificate_profile.parameters.distinguished_name.state }}"
{%         endif %}
{%         if auto_certificate_profile.parameters.distinguished_name.locality is arista.avd.defined %}
      parameters distinguished-name locality "{{ auto_certificate_profile.parameters.distinguished_name.locality }}"
{%         endif %}
{%         if auto_certificate_profile.parameters.distinguished_name.organization is arista.avd.defined %}
      parameters distinguished-name organization "{{ auto_certificate_profile.parameters.distinguished_name.organization }}"
{%         endif %}
{%         if auto_certificate_profile.parameters.distinguished_name.organization_unit is arista.avd.defined %}
      parameters distinguished-name organization-unit "{{ auto_certificate_profile.parameters.distinguished_name.organization_unit }}"
{%         endif %}
{%         if auto_certificate_profile.parameters.distinguished_name.email is arista.avd.defined %}
      parameters distinguished-name email {{ auto_certificate_profile.parameters.distinguished_name.email }}
{%         endif %}
{%         if auto_certificate_profile.parameters.distinguished_name.serial_number is arista.avd.defined %}
{%             set auto_cert_dn_serial = auto_certificate_profile.parameters.distinguished_name.serial_number %}
{%             if auto_cert_dn_serial != "system" %}
{%                 set auto_cert_dn_serial = '"' ~ auto_cert_dn_serial ~ '"' %}
{%             endif %}
      parameters distinguished-name serial-number {{ auto_cert_dn_serial }}
{%         endif %}
{%         if auto_certificate_profile.parameters.subject_alternative_name.ip is arista.avd.defined %}
      parameters subject-alternative-name ip {{ auto_certificate_profile.parameters.subject_alternative_name.ip | arista.avd.natural_sort | join(' ') }}
{%         endif %}
{%         if auto_certificate_profile.parameters.subject_alternative_name.dns is arista.avd.defined %}
      parameters subject-alternative-name dns {{ auto_certificate_profile.parameters.subject_alternative_name.dns | arista.avd.natural_sort | join(' ') }}
{%         endif %}
{%         if auto_certificate_profile.parameters.subject_alternative_name.email is arista.avd.defined %}
      parameters subject-alternative-name email {{ auto_certificate_profile.parameters.subject_alternative_name.email | arista.avd.natural_sort | join(' ') }}
{%         endif %}
{%         if auto_certificate_profile.parameters.subject_alternative_name.uri is arista.avd.defined %}
      parameters subject-alternative-name uri {{ auto_certificate_profile.parameters.subject_alternative_name.uri | arista.avd.natural_sort | join(' ') }}
{%         endif %}
{%         if auto_certificate_profile.protocol_instance_name is arista.avd.defined %}
      protocol instance {{ auto_certificate_profile.protocol_instance_name }}
{%         endif %}
{%         if auto_certificate_profile.digest is arista.avd.defined %}
      digest {{ auto_certificate_profile.digest }}
{%         endif %}
{%         if auto_certificate_profile.renewal is arista.avd.defined %}
      renewal {{ auto_certificate_profile.renewal }} seconds
{%         endif %}
   !
{%     endfor %}
{%     for auto_certificate_protocol in management_security.auto_certificate.protocols | arista.avd.natural_sort(sort_key="name", ignore_case=false) %}
   auto-certificate protocol {{ auto_certificate_protocol.protocol }} {{ auto_certificate_protocol.name }}
{%         if auto_certificate_protocol.server.url is arista.avd.defined %}
      server url {{ auto_certificate_protocol.server.url }}
{%         endif %}
{%         if auto_certificate_protocol.server.ssl_profile is arista.avd.defined %}
      server ssl profile {{ auto_certificate_protocol.server.ssl_profile }}
{%         endif %}
{%         if auto_certificate_protocol.server.vrf is arista.avd.defined %}
      server vrf {{ auto_certificate_protocol.server.vrf }}
{%         endif %}
{%         if auto_certificate_protocol.connection_retry.interval is arista.avd.defined %}
{%             set conn_retry_interval = "connection retry interval " ~ auto_certificate_protocol.connection_retry.interval ~ " seconds" %}
{%             if auto_certificate_protocol.connection_retry.exponential_backoff is arista.avd.defined(true) %}
{%                 set conn_retry_interval = conn_retry_interval ~ " backoff exponential" %}
{%             endif %}
      {{ conn_retry_interval }}
{%         endif %}
{%         if auto_certificate_protocol.connection_retry.count is arista.avd.defined %}
      connection retry count {{ auto_certificate_protocol.connection_retry.count }}
{%         endif %}
{%         if auto_certificate_protocol.disabled is arista.avd.defined(true) %}
      disabled
{%         endif %}
{%         if auto_certificate_protocol.credentials.enroll.token is arista.avd.defined %}
      credentials enroll token {{ auto_certificate_protocol.credentials.enroll.token_type | arista.avd.default("7") }} {{ auto_certificate_protocol.credentials.enroll.token | arista.avd.hide_passwords(hide_passwords) }}
{%         elif auto_certificate_protocol.credentials.enroll.username is arista.avd.defined and auto_certificate_protocol.credentials.enroll.secret is arista.avd.defined %}
      credentials enroll username {{ auto_certificate_protocol.credentials.enroll.username }} secret {{ auto_certificate_protocol.credentials.enroll.secret_type | arista.avd.default("7") }} {{ auto_certificate_protocol.credentials.enroll.secret | arista.avd.hide_passwords(hide_passwords) }}
{%         elif auto_certificate_protocol.credentials.enroll.secret is arista.avd.defined %}
      credentials enroll secret {{ auto_certificate_protocol.credentials.enroll.secret_type | arista.avd.default("7") }} {{ auto_certificate_protocol.credentials.enroll.secret | arista.avd.hide_passwords(hide_passwords) }}
{%         endif %}
{%         if auto_certificate_protocol.credentials.re_enroll.token is arista.avd.defined %}
      credentials re-enroll token {{ auto_certificate_protocol.credentials.re_enroll.token_type | arista.avd.default("7") }} {{ auto_certificate_protocol.credentials.re_enroll.token | arista.avd.hide_passwords(hide_passwords) }}
{%         elif auto_certificate_protocol.credentials.re_enroll.username is arista.avd.defined and auto_certificate_protocol.credentials.re_enroll.secret is arista.avd.defined %}
      credentials re-enroll username {{ auto_certificate_protocol.credentials.re_enroll.username }} secret {{ auto_certificate_protocol.credentials.re_enroll.secret_type | arista.avd.default("7") }} {{ auto_certificate_protocol.credentials.re_enroll.secret | arista.avd.hide_passwords(hide_passwords) }}
{%         elif auto_certificate_protocol.credentials.re_enroll.secret is arista.avd.defined %}
      credentials re-enroll secret {{ auto_certificate_protocol.credentials.re_enroll.secret_type | arista.avd.default("7") }} {{ auto_certificate_protocol.credentials.re_enroll.secret | arista.avd.hide_passwords(hide_passwords) }}
{%         endif %}
   !
{%     endfor %}
{%     if management_security.entropy_sources is arista.avd.defined %}
{%         set entropy_sources = [] %}
{%         for source in ['hardware', 'haveged', 'cpu_jitter'] %}
{%             if management_security.entropy_sources[source] is arista.avd.defined(true) %}
{%                 do entropy_sources.append(source.replace("_", " ")) %}
{%             endif %}
{%         endfor %}
{%         if entropy_sources %}
   entropy source {{ entropy_sources | join(" ") }}
{%         endif %}
{%         if management_security.entropy_sources.hardware_exclusive is arista.avd.defined(true) %}
   entropy source hardware exclusive
{%         endif %}
{%     endif %}
{%     if management_security.password.minimum_length is arista.avd.defined %}
   password minimum length {{ management_security.password.minimum_length }}
{%     endif %}
{%     if management_security.password.encryption_key_common is arista.avd.defined(true) %}
   password encryption-key common
{%     endif %}
{%     if management_security.signature_verification.enabled is arista.avd.defined(true) %}
{%         set signature_verification_cli = "signature-verification extension" %}
{%         if management_security.signature_verification.ssl_profile is arista.avd.defined %}
{%             set signature_verification_cli = signature_verification_cli ~ " ssl profile " ~ management_security.signature_verification.ssl_profile %}
{%         endif %}
   {{ signature_verification_cli }}
{%     endif %}
{%     if management_security.password.encryption_reversible is arista.avd.defined() %}
   password encryption reversible {{ management_security.password.encryption_reversible }}
{%     endif %}
{%     for policy in management_security.password.policies | arista.avd.natural_sort(sort_key="name", ignore_case=false) %}
   !
   password policy {{ policy.name }}
{%         if policy.minimum is arista.avd.defined %}
{%             if policy.minimum.digits is arista.avd.defined %}
      minimum digits {{ policy.minimum.digits }}
{%             endif %}
{%             if policy.minimum.length is arista.avd.defined %}
      minimum length {{ policy.minimum.length }}
{%             endif %}
{%             if policy.minimum.lower is arista.avd.defined %}
      minimum lower {{ policy.minimum.lower }}
{%             endif %}
{%             if policy.minimum.special is arista.avd.defined %}
      minimum special {{ policy.minimum.special }}
{%             endif %}
{%             if policy.minimum.upper is arista.avd.defined %}
      minimum upper {{ policy.minimum.upper }}
{%             endif %}
{%         endif %}
{%         if policy.maximum is arista.avd.defined %}
{%             if policy.maximum.repetitive is arista.avd.defined %}
      maximum repetitive {{ policy.maximum.repetitive }}
{%             endif %}
{%             if policy.maximum.sequential is arista.avd.defined %}
      maximum sequential {{ policy.maximum.sequential }}
{%             endif %}
{%         endif %}
{%     endfor %}
{%     for profile in management_security.shared_secret_profiles | arista.avd.natural_sort(sort_key="profile", ignore_case=false) %}
   !
   session shared-secret profile {{ profile.profile }}
{%         for secret in profile.secrets | arista.avd.natural_sort(sort_key="name", ignore_case=false) %}
{%             if secret.secret is arista.avd.defined and
                  ((secret.receive_lifetime.infinite is arista.avd.defined(true) or (secret.receive_lifetime.start_date_time and secret.receive_lifetime.end_date_time is arista.avd.defined)) and
                   (secret.transmit_lifetime.infinite is arista.avd.defined(true) or (secret.transmit_lifetime.start_date_time and secret.transmit_lifetime.end_date_time is arista.avd.defined))) %}
{%                 set secret_cli = "secret " ~ secret.name ~ " " ~ secret.secret_type | arista.avd.default("7") ~ " " ~ secret.secret | arista.avd.hide_passwords(hide_passwords) %}
{%                 if secret.receive_lifetime.infinite is arista.avd.defined(true) %}
{%                     set secret_cli = secret_cli ~ " receive-lifetime infinite" %}
{%                 else %}
{%                     set secret_cli = secret_cli ~ " receive-lifetime " ~ secret.receive_lifetime.start_date_time ~ " " ~ secret.receive_lifetime.end_date_time %}
{%                 endif %}
{%                 if secret.transmit_lifetime.infinite is arista.avd.defined(true) %}
{%                     set secret_cli = secret_cli ~ " transmit-lifetime infinite" %}
{%                 else %}
{%                     set secret_cli = secret_cli ~ " transmit-lifetime " ~ secret.transmit_lifetime.start_date_time ~ " " ~ secret.transmit_lifetime.end_date_time %}
{%                 endif %}
{%                 if secret.local_time is arista.avd.defined(true) %}
{%                     set secret_cli = secret_cli ~ " local-time" %}
{%                 endif %}
      {{ secret_cli }}
{%             endif %}
{%         endfor %}
{%     endfor %}
{%     for ssl_profile in management_security.ssl_profiles | arista.avd.natural_sort(sort_key="name", ignore_case=false) %}
   !
   ssl profile {{ ssl_profile.name }}
{%         if ssl_profile.tls_versions is arista.avd.defined %}
      tls versions {{ ssl_profile.tls_versions }}
{%         endif %}
{%         if ssl_profile.fips_restrictions is arista.avd.defined(true) %}
      fips restrictions
{%         endif %}
{%         if ssl_profile.ciphers.v1_0 is arista.avd.defined %}
      cipher v1.0 {{ ssl_profile.ciphers.v1_0 }}
{%         elif ssl_profile.cipher_list is arista.avd.defined %}
      cipher-list {{ ssl_profile.cipher_list }}
{%         endif %}
{%         if ssl_profile.ciphers.v1_3 is arista.avd.defined %}
      cipher v1.3 {{ ssl_profile.ciphers.v1_3 }}
{%         endif %}
{%         if ssl_profile.certificate is arista.avd.defined %}
      certificate {{ ssl_profile.certificate.file }} key {{ ssl_profile.certificate.key }}
{%         endif %}
{%         if ssl_profile.trust_certificate is arista.avd.defined %}
{%             if ssl_profile.trust_certificate.system is arista.avd.defined(true) %}
      trust certificate system
{%             endif %}
{%             for trust_cert in ssl_profile.trust_certificate.certificates | arista.avd.natural_sort %}
      trust certificate {{ trust_cert }}
{%             endfor %}
{%         endif %}
{%         for chain_cert in ssl_profile.chain_certificate.certificates | arista.avd.natural_sort %}
      chain certificate {{ chain_cert }}
{%         endfor %}
{%         for crl in ssl_profile.certificate_revocation_lists | arista.avd.natural_sort %}
      crl {{ crl }}
{%         endfor %}
{%         if ssl_profile.trust_certificate.requirement is arista.avd.defined %}
{%             if ssl_profile.trust_certificate.requirement.basic_constraint_ca is arista.avd.defined(true) %}
      trust certificate requirement basic-constraint ca true
{%             endif %}
{%             if ssl_profile.trust_certificate.requirement.hostname_fqdn is arista.avd.defined(true) %}
      trust certificate requirement hostname fqdn
{%             endif %}
{%         endif %}
{%         if ssl_profile.chain_certificate.requirement.basic_constraint_ca is arista.avd.defined(true) %}
      chain certificate requirement basic-constraint ca true
{%         endif %}
{%         if ssl_profile.trust_certificate.policy_expiry_date_ignore is arista.avd.defined(true) %}
      trust certificate policy expiry-date ignore
{%         endif %}
{%         if ssl_profile.chain_certificate.requirement.include_root_ca is arista.avd.defined(true) %}
      chain certificate requirement include root-ca
{%         endif %}
{%     endfor %}
{% endif %}
