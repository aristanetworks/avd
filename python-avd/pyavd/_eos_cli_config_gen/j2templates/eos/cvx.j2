{# eos - cvx #}
{% if cvx is arista.avd.defined %}
!
cvx
{%     if cvx.shutdown is arista.avd.defined(true) %}
   shutdown
{%     elif cvx.shutdown is arista.avd.defined(false) %}
   no shutdown
{%     endif %}
{%     for peer_host in cvx.peer_hosts | arista.avd.natural_sort %}
   peer host {{ peer_host }}
{%     endfor %}
{%     if cvx.services.mcs is arista.avd.defined %}
   !
   service mcs
{%         if cvx.services.mcs.redis.password is arista.avd.defined %}
      redis password {{ cvx.services.mcs.redis.password_type | arista.avd.default("7") }} {{ cvx.services.mcs.redis.password | arista.avd.hide_passwords(hide_passwords) }}
{%         endif %}
{%         if cvx.services.mcs.shutdown is arista.avd.defined(false) %}
      no shutdown
{%         elif cvx.services.mcs.shutdown is arista.avd.defined(true) %}
      shutdown
{%         endif %}
{%     endif %}
{%     if cvx.services.openstack is arista.avd.defined %}
   !
   service openstack
{%         if cvx.services.openstack.ip_access_group_name is arista.avd.defined %}
      ip access-group {{ cvx.services.openstack.ip_access_group_name }}
{%         endif %}
{%         if cvx.services.openstack.ipv6_access_group_name is arista.avd.defined %}
      ipv6 access-group {{ cvx.services.openstack.ipv6_access_group_name }}
{%         endif %}
{%         if cvx.services.openstack.shutdown is arista.avd.defined(false) %}
      no shutdown
{%         elif cvx.services.openstack.shutdown is arista.avd.defined(true) %}
      shutdown
{%         endif %}
{%         if cvx.services.openstack.grace_period is arista.avd.defined %}
      grace-period {{ cvx.services.openstack.grace_period }}
{%         endif %}
{%         if cvx.services.openstack.network_type_driver.vlan is arista.avd.defined %}
      network type-driver vlan {{ cvx.services.openstack.network_type_driver.vlan }}
{%         endif %}
{%         if cvx.services.openstack.authentication.role is arista.avd.defined %}
      authentication role {{ cvx.services.openstack.authentication.role }}
{%         endif %}
{%         if cvx.services.openstack.name_resolution.interval is arista.avd.defined %}
      name-resolution interval {{ cvx.services.openstack.name_resolution.interval }}
{%         endif %}
{%         for region in cvx.services.openstack.regions | arista.avd.natural_sort(sort_key='name', ignore_case=false) %}
      !
      region {{ region.name }}
{%             if region.username is arista.avd.defined and region.password is arista.avd.defined and region.password_type is arista.avd.defined and region.tenant is arista.avd.defined %}
         username {{ region.username }} tenant {{ region.tenant }} password {{ region.password_type | arista.avd.default("7") }} {{ region.password }}
{%             endif %}
{%             if region.keystone.auth_url is arista.avd.defined %}
         keystone auth-url {{ region.keystone.auth_url }}
{%             endif %}
{%         endfor %}
{%     endif %}
{%     if cvx.services.vxlan is arista.avd.defined %}
   !
   service vxlan
{%         if cvx.services.vxlan.shutdown is arista.avd.defined(false) %}
      no shutdown
{%         elif cvx.services.vxlan.shutdown is arista.avd.defined(true) %}
      shutdown
{%         endif %}
{%         if cvx.services.vxlan.vtep_mac_learning is arista.avd.defined %}
      vtep mac-learning {{ cvx.services.vxlan.vtep_mac_learning }}
{%         endif %}
{%     endif %}
{% endif %}
