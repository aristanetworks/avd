{# eos - errdisable #}
{% if errdisable is arista.avd.defined %}
!
{%     for cause in errdisable.detect.causes | arista.avd.natural_sort %}
errdisable detect cause {{ cause }}
{%     endfor %}
{%     set interval_namespace = namespace(intervals=[]) %}
{%     for cause in errdisable.recovery.causes | arista.avd.natural_sort %}
{%         if errdisable.recovery.intervals is arista.avd.defined %}
{%             set cause_index = errdisable.recovery.causes.index(cause) %}
{%             set interval_cli = "errdisable recovery cause " ~ cause ~ " interval " ~ errdisable.recovery.intervals[cause_index] %}
{%             do interval_namespace.intervals.append(interval_cli) %}
{%         endif %}
errdisable recovery cause {{ cause }}
{%     endfor %}
{%     for interval in interval_namespace.intervals | arista.avd.default([]) %}
{%         if "none" is not in interval %}
{{ interval }}
{%         endif %}
{%     endfor %}
{%     if errdisable.recovery.interval is arista.avd.defined %}
errdisable recovery interval {{ errdisable.recovery.interval }}
{%     endif %}
{% endif %}
