{%             endif %}
      {{ redistribute_ospfv3_match_external_cli }}
{%         endif %}
{%         if vrf.address_family_ipv6.redistribute.ospfv3.match_nssa_external.enabled is arista.avd.defined(true) %}
{%             set redistribute_ospfv3_match_nssa_external_cli = "redistribute ospfv3 leaked match nssa-external" %}
{%             if vrf.address_family_ipv6.redistribute.ospfv3.match_nssa_external.route_map is arista.avd.defined %}
{%                 set redistribute_ospfv3_match_nssa_external_cli = redistribute_ospfv3_match_nssa_external_cli ~ " route-map " ~ vrf.address_family_ipv6.redistribute.ospfv3.match_nssa_external.route_map %}
{%             endif %}
      {{ redistribute_ospfv3_match_nssa_external_cli }}
{%         endif %}
{%         if vrf.address_family_ipv6.redistribute.static.enabled is arista.avd.defined(true) %}
