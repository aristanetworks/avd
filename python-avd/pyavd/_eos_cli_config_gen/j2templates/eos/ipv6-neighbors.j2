{# eos - ipv6 neighbors #}
{% if ipv6_neighbor.persistent.enabled is arista.avd.defined(true) or ipv6_neighbor.static_entries is arista.avd.defined %}
!
{%     if ipv6_neighbor.persistent.enabled is arista.avd.defined(true) %}
{%         set persistent_cli = "ipv6 neighbor persistent" %}
{%         if ipv6_neighbor.persistent.refresh_delay is arista.avd.defined %}
{%             set persistent_cli = persistent_cli ~ " refresh-delay " ~ ipv6_neighbor.persistent.refresh_delay %}
{%         endif %}
{{ persistent_cli }}
{%     endif %}
{%     if ipv6_neighbor.static_entries is arista.avd.defined %}
{%         for neighbor in ipv6_neighbor.static_entries | rejectattr("vrf", "arista.avd.defined") | arista.avd.natural_sort(sort_key='interface') | arista.avd.natural_sort(sort_key='ipv6_address', sort_as_ip_address=true) %}
ipv6 neighbor {{ neighbor.ipv6_address }} {{ neighbor.interface }} {{ neighbor.mac_address }}
{%         endfor %}
{%         for neighbor in ipv6_neighbor.static_entries | selectattr("vrf", "arista.avd.defined") | arista.avd.natural_sort(sort_key='interface') | arista.avd.natural_sort(sort_key='ipv6_address', sort_as_ip_address=true) | arista.avd.natural_sort(sort_key='vrf', ignore_case=false) %}
ipv6 neighbor vrf {{ neighbor.vrf }} {{ neighbor.ipv6_address }} {{ neighbor.interface }} {{ neighbor.mac_address }}
{%         endfor %}
{%     endif %}
{% endif %}
