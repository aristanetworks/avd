{% if eos_config_future.render_combined_separator_for_ipv6_hardware_and_unicast_routing is arista.avd.defined(true) %}
{%     set ipv6_unicast_routing_vrfs = vrfs | arista.avd.natural_sort('name', ignore_case=false) |
        selectattr('ipv6_routing', 'defined') |
        selectattr('ipv6_routing', 'equalto', true) |
        rejectattr('name', 'equalto', 'default') |
        list %}
{%     if ipv6_hardware.fib.optimize.prefixes.profile is arista.avd.defined or
          ipv6_unicast_routing is arista.avd.defined(true) or
          (ipv6_unicast_routing_vrfs | length) > 0 %}
!
{%         if ipv6_unicast_routing is arista.avd.defined(true) %}
ipv6 unicast-routing
{%         endif %}
{%         if ipv6_hardware.fib.optimize.prefixes.profile is arista.avd.defined %}
ipv6 hardware fib optimize prefixes profile {{ ipv6_hardware.fib.optimize.prefixes.profile }}
{%         endif %}
{%         for vrf in ipv6_unicast_routing_vrfs %}
ipv6 unicast-routing vrf {{ vrf.name }}
{%         endfor %}
{%     endif %}
{% else %}
{## IPv6 default vrf unicast routing #}
{%     include 'eos/ipv6-unicast-routing.j2' %}
{## IPv6 hardware FIB optimize prefixes profile #}
{%     include 'eos/ipv6-hardware.j2' %}
{## IPv6 non default vrf unicast routing #}
{%     include 'eos/ipv6-unicast-routing-vrfs.j2' %}
{% endif %}
