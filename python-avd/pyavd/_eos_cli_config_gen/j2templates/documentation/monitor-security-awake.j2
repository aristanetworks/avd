{# monitor security awake #}
{% if monitor_security.awake is arista.avd.defined %}
!
#### Monitor security awake
{%     set disabled = monitor_security.awake.disabled | arista.avd.default('-') %}
{%     set flow_table_size = monitor_security.awake.flow_table_size | arista.avd.default('-') %}
{%     set ipfix_listener_port = monitor_security.awake.ipfix_listener_port | arista.avd.default('4739') %}
{%     set monitor_point_identifier = monitor_security.awake.monitor_point_identifier | arista.avd.default('-') %}
{%     set unknown_udp = monitor_security.awake.ndr_application.unknown_udp | arista.avd.default('-') %}
{%     set topic = monitor_security.awake.topic | arista.avd.default('-') %}

| Disabled | flow table size entries | ipfix listener port | monitor point identifier | unknown udp ndr application | topic |
| -------- | ----------------------- | ------------------- | ------------------------ | --------------------------- | ----- |
| {{ disabled }} | {{ flow_table_size }} | {{ ipfix_listener_port }} | {{ monitor_point_identifier }} | {{ unknown_udp }} | {{ topic }} |
{%     if monitor_security.awake.nucleus is arista.avd.defined %}
#### Nucleus
| Name | Local Interface | Destination IP | Port | SSL Profile |
| ---- | --------------- | -------------- | ---- | ----------- |
{%         for nucleus in monitor_security.awake.nucleus[:2] %}
{%             set name = nucleus.name | arista.avd.default('-') %}
{%             set local_interface = nucleus.local_interface | arista.avd.default('-') %}
{%             set destination = nucleus.destination | arista.avd.default('-') %}
{%             set port = nucleus.port | arista.avd.default('9094') %}
{%             set ssl_profile = nucleus.ssl_profile | arista.avd.default('-') %}
| {{ name }} | {{ local_interface }} | {{ destination }} | {{ port }} | {{ ssl_profile }} |
{%         endfor %}
{%     endif %}
{% endif %}
