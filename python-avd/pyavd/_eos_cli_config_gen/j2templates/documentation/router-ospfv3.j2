### Router OSPFv3
{%     set ns = namespace(has_summary=false) %}
{%     if (router_ospfv3.router_id is arista.avd.defined
               and router_ospfv3.address_family_ipv4.router_id is not arista.avd.defined
               and router_ospfv3.address_family_ipv6.router_id is not arista.avd.defined)
           or (router_ospfv3.passive_interface_default is arista.avd.defined(true)
               and router_ospfv3.address_family_ipv4.passive_interface_default is not arista.avd.defined(true)
               and router_ospfv3.address_family_ipv6.passive_interface_default is not arista.avd.defined(true))
           or (router_ospfv3.auto_cost_reference_bandwidth is arista.avd.defined
               and router_ospfv3.address_family_ipv4.auto_cost_reference_bandwidth is not arista.avd.defined
               and router_ospfv3.address_family_ipv6.auto_cost_reference_bandwidth is not arista.avd.defined) %}
{%         set ns.has_summary = true %}
{%     endif %}
{%     if not ns.has_summary %}
{%         for vrf in router_ospfv3.vrfs | arista.avd.default([]) %}
{%             if (vrf.router_id is arista.avd.defined
                       and vrf.address_family_ipv4.router_id is not arista.avd.defined
                       and vrf.address_family_ipv6.router_id is not arista.avd.defined)
                   or (vrf.passive_interface_default is arista.avd.defined(true)
                       and vrf.address_family_ipv4.passive_interface_default is not arista.avd.defined(true)
                       and vrf.address_family_ipv6.passive_interface_default is not arista.avd.defined(true))
                   or (vrf.auto_cost_reference_bandwidth is arista.avd.defined
                       and vrf.address_family_ipv4.auto_cost_reference_bandwidth is not arista.avd.defined
                       and vrf.address_family_ipv6.auto_cost_reference_bandwidth is not arista.avd.defined) %}
{%                 set ns.has_summary = true %}
{%                 break %}
{%             endif %}
{%         endfor %}
{%     endif %}
