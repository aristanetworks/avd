#### Router OSPFv3 IPv4 Address Family Redistribution

| VRF | Source Protocol | Include Leaked | Route Map |
| --- | --------------- | -------------- | --------- |
{%         set ospfv3_redistribute_contexts = [] %}
{%         if router_ospfv3.address_family_ipv4.enabled is arista.avd.defined(true) and router_ospfv3.address_family_ipv4.redistribute is arista.avd.defined %}
{%             do ospfv3_redistribute_contexts.append(('default', router_ospfv3.address_family_ipv4.redistribute)) %}
{%         endif %}
{%         for vrf in router_ospfv3.vrfs | arista.avd.natural_sort('name') %}
{%             if vrf.address_family_ipv4.enabled is arista.avd.defined(true) and vrf.address_family_ipv4.redistribute is arista.avd.defined %}
{%                 do ospfv3_redistribute_contexts.append((vrf.name, vrf.address_family_ipv4.redistribute)) %}
{%             endif %}
{%         endfor %}
{%         for context in ospfv3_redistribute_contexts %}
{%             set vrf_name = context[0] %}
{%             set redistribute = context[1] %}
{%             if redistribute.bgp.enabled is arista.avd.defined(true) %}
{%                 set include_leaked = redistribute.bgp.include_leaked | arista.avd.default('-') %}
| {{ vrf_name }} | bgp | {{ include_leaked }} | {{ redistribute.bgp.route_map | arista.avd.default('-') }} |
{%             endif %}
{%             if redistribute.connected.enabled is arista.avd.defined(true) %}
{%                 set include_leaked = redistribute.connected.include_leaked | arista.avd.default('-') %}
| {{ vrf_name }} | connected | {{ include_leaked }} | {{ redistribute.connected.route_map | arista.avd.default('-') }} |
{%             endif %}
{%             if redistribute.isis.enabled is arista.avd.defined(true) %}
{%                 if redistribute.isis.level is arista.avd.defined %}
{%                     set isis_label = 'isis ' ~ redistribute.isis.level %}
{%                 else %}
{%                     set isis_label = 'isis' %}
{%                 endif %}
{%                 set include_leaked = redistribute.isis.include_leaked | arista.avd.default('-') %}
| {{ vrf_name }} | {{ isis_label }} | {{ include_leaked }} | {{ redistribute.isis.route_map | arista.avd.default('-') }} |
{%             endif %}
{%             if redistribute.ospfv3.enabled is arista.avd.defined(true) %}
| {{ vrf_name }} | ospfv3 | True | {{ redistribute.ospfv3.route_map | arista.avd.default('-') }} |
{%             endif %}
{%             if redistribute.ospfv3.match_internal.enabled is arista.avd.defined(true) %}
| {{ vrf_name }} | ospfv3 match internal | True | {{ redistribute.ospfv3.match_internal.route_map | arista.avd.default('-') }} |
{%             endif %}
{%             if redistribute.ospfv3.match_external.enabled is arista.avd.defined(true) %}
| {{ vrf_name }} | ospfv3 match external | True | {{ redistribute.ospfv3.match_external.route_map | arista.avd.default('-') }} |
{%             endif %}
{%             if redistribute.ospfv3.match_nssa_external.enabled is arista.avd.defined(true) %}
| {{ vrf_name }} | ospfv3 match nssa-external | True | {{ redistribute.ospfv3.match_nssa_external.route_map | arista.avd.default('-') }} |
{%             endif %}
{%             if redistribute.static.enabled is arista.avd.defined(true) %}
{%                 set include_leaked = redistribute.static.include_leaked | arista.avd.default('-') %}
| {{ vrf_name }} | static | {{ include_leaked }} | {{ redistribute.static.route_map | arista.avd.default('-') }} |
{%             endif %}
{%         endfor %}
{%     endif %}
