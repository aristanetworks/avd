{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "dependencyDashboard": {
    "enabled": true
  },
  "semanticCommits": "disabled",
  "enabledManagers": [
    "pep621",
    "github-actions",
    "pre-commit",
    "ansible-galaxy",
    "docker-compose"
  ],
  "pre-commit": {
    "enabled": true
  },
  // Renovate's uv installer does not inherit required-version from the workspace root
  // for member updates. Keep this aligned with [tool.uv].required-version.
  "constraints": {
    "uv": ">=0.9.17"
  },
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "gitIgnoredAuthors": [
    "114827586+autofix-ci[bot]@users.noreply.github.com"
  ],
  // The pep621 manager maintains the shared root uv.lock once PR #7201 adds it.
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"],
    "rebaseWhen": "behind-base-branch",
    "labels": ["type: dependencies"],
    "commitMessagePrefix": "CI(requirements): "
  },
  "packageRules": [
    {
      "description": "Let uv enforce release age during lockfile maintenance",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Maintain Python runtime and optional dependencies",
      "matchManagers": ["pep621"],
      "matchDepTypes": [
        "project.dependencies",
        "project.optional-dependencies"
      ],
      "labels": ["type: dependencies"],
      "commitMessagePrefix": "Bump(requirements): ",
      "rangeStrategy": "auto"
    },
    {
      "description": "Group non-major Python runtime updates",
      "matchManagers": ["pep621"],
      "matchDepTypes": [
        "project.dependencies",
        "project.optional-dependencies"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python runtime dependencies",
      "groupSlug": "python-runtime"
    },
    // Advance tooling minimums without raising published runtime compatibility floors.
    {
      "description": "Maintain Python development and build dependencies",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups", "build-system.requires"],
      "labels": ["type: dependencies"],
      "commitMessagePrefix": "CI(requirements): ",
      "rangeStrategy": "bump"
    },
    {
      "description": "Group non-major Python tooling updates",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups", "build-system.requires"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python tooling dependencies",
      "groupSlug": "python-tooling"
    },
    {
      "description": "Keep legacy Molecule compatibility pins under manual control",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "matchPackageNames": ["molecule", "ansible-compat"],
      "matchCurrentValue": "==26.6.0",
      "enabled": false
    },
    {
      "description": "Keep supported Python versions under manual control",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Keep GitHub Actions pinned to immutable commits",
      "matchManagers": ["github-actions"],
      "labels": ["type: dependencies"],
      "commitMessagePrefix": "CI: ",
      "pinDigests": true
    },
    {
      "description": "Keep the supported Python CI matrix under manual control",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["python"],
      "enabled": false
    },
    {
      "description": "Maintain pre-commit hook revisions",
      "matchManagers": ["pre-commit"],
      "matchDepTypes": ["repository"],
      "labels": ["type: dependencies"],
      "commitMessagePrefix": "CI: "
    },
    {
      "description": "Maintain pre-commit Python environments",
      "matchManagers": ["pre-commit"],
      "matchDepTypes": ["pre-commit-python"],
      "labels": ["type: dependencies"],
      "commitMessagePrefix": "CI: ",
      "rangeStrategy": "bump"
    },
    // Propose support for new Ansible releases without dropping older Python/Ansible combinations.
    {
      "description": "Widen supported Ansible ranges without raising their minimum",
      "matchManagers": ["pep621", "pre-commit"],
      "matchPackageNames": ["ansible-core"],
      "rangeStrategy": "widen"
    },
    // Keep the doc extractor on compatible 2.18.x releases until its newer-Ansible issues are fixed.
    // See https://github.com/xlab-steampunk/ansible-doc-extractor/issues/34.
    {
      "description": "Keep doc extractor Ansible updates within 2.18",
      "matchManagers": ["pre-commit"],
      "matchPackageNames": ["ansible-core"],
      "matchCurrentValue": "/^~=2\\.18\\./",
      "allowedVersions": ">=2.18.0,<2.19.0",
      "rangeStrategy": "bump"
    },
    {
      "description": "Maintain Ansible Galaxy collection requirements",
      "matchManagers": ["ansible-galaxy"],
      "labels": ["type: dependencies"],
      "commitMessagePrefix": "CI(requirements): "
    },
    {
      "description": "Keep Docker Compose images current",
      "matchManagers": ["docker-compose"],
      "labels": ["type: dependencies"],
      "commitMessagePrefix": "CI(containers): ",
      "pinDigests": true
    },
    // Group only tools that have the same package represented in pyproject.toml
    // and in a pre-commit repository. Pyright is intentionally excluded: AVD
    // has no project Pyright dependency, and pyright-python and pyright-action
    // are independent packages.
    {
      "description": "Group Ruff updates across Python and pre-commit",
      "matchManagers": ["pep621", "pre-commit"],
      "matchPackageNames": ["ruff", "astral-sh/ruff-pre-commit"],
      "groupName": "Ruff",
      "groupSlug": "ruff",
      "commitMessagePrefix": "CI: "
    },
    {
      "description": "Group Pylint updates across Python and pre-commit",
      "matchManagers": ["pep621", "pre-commit"],
      "matchPackageNames": ["pylint", "pycqa/pylint"],
      "groupName": "Pylint",
      "groupSlug": "pylint",
      "commitMessagePrefix": "CI: "
    },
    {
      "description": "Group codespell updates across Python and pre-commit",
      "matchManagers": ["pep621", "pre-commit"],
      "matchPackageNames": ["codespell", "codespell-project/codespell"],
      "groupName": "codespell",
      "groupSlug": "codespell",
      "commitMessagePrefix": "CI: "
    },
    {
      "description": "Group yamllint updates across Python and pre-commit",
      "matchManagers": ["pep621", "pre-commit"],
      "matchPackageNames": ["yamllint", "adrienverge/yamllint"],
      "groupName": "yamllint",
      "groupSlug": "yamllint",
      "commitMessagePrefix": "CI: "
    },
    {
      "description": "Group pre-commit-hooks updates across Python and pre-commit",
      "matchManagers": ["pep621", "pre-commit"],
      "matchPackageNames": ["pre-commit-hooks", "pre-commit/pre-commit-hooks"],
      "groupName": "pre-commit-hooks",
      "groupSlug": "pre-commit-hooks",
      "commitMessagePrefix": "CI: "
    },
    {
      "description": "Require dashboard approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
